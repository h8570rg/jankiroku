{
  "name": "jankiroku",
  "version": "0.2.0",
  "description": "麻雀成績管理アプリケーション",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "check": "oxlint --fix && oxfmt",
    "type": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "spell": "cspell . --gitignore",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:migration": "supabase migration new",
    "supabase:diff": "supabase db diff --schema public",
    "supabase:push": "supabase db push --remote",
    "supabase:type": "supabase gen types typescript > lib/database.types.ts"
  },
  "dependencies": {
    "@conform-to/react": "1.21.3",
    "@conform-to/zod": "1.21.3",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@iconify/react": "6.0.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tailwindcss/postcss": "4.3.5",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "dayjs": "1.11.23",
    "lucide-react": "1.69.0",
    "motion": "14.9.1",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "use-debounce": "10.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cspell": "10.4.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tailwindcss": "1.17.1",
    "supabase": "3.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.18.0"
}
