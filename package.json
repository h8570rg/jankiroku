{
  "name": "jankiroku",
  "version": "0.2.0",
  "description": "麻雀成績管理アプリケーション",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "check": "oxlint --fix && oxfmt",
    "type": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "spell": "cspell . --gitignore",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link --project-ref $npm_package_config_supabase_project_ref",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:migration": "supabase migration new",
    "supabase:diff": "supabase db diff --local --schema public",
    "supabase:push": "supabase db push",
    "supabase:type": "supabase gen types typescript --local > lib/database.types.ts"
  },
  "dependencies": {
    "@conform-to/react": "1.21.0",
    "@conform-to/zod": "1.21.0",
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@iconify/react": "6.0.2",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@tailwindcss/postcss": "4.3.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "dayjs": "1.11.23",
    "lucide-react": "1.31.0",
    "motion": "13.1.0",
    "next": "16.3.1",
    "next-themes": "0.4.6",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "use-debounce": "10.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cspell": "10.0.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tailwindcss": "1.9.0",
    "supabase": "2.114.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "config": {
    "supabase_project_ref": "ggkmppnjhrwzdsamzqbp"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.22.0"
}
